# ============ Wajib diisi (Coolify > Application > Environment Variables) ============
# Salin key di bawah ke Coolify satu per satu, atau pakai "Developer view" lalu tempel semua.
# Semua env dibaca saat RUNTIME — jangan centang "Build Variable". Setelah mengubah env: Redeploy.

# MariaDB / MySQL connection string (Coolify > MariaDB > "MariaDB URL (internal)")
# Format: mysql://USER:PASSWORD@HOST:3306/NAMA_DB
DATABASE_URL="mysql://mariadb:PASSWORD@nama-host-internal:3306/default"

# Alternatif bila tidak memakai DATABASE_URL:
# DB_HOST="127.0.0.1"
# DB_PORT="3306"
# DB_USER="mariadb"
# DB_PASSWORD="..."
# DB_NAME="default"

# Kunci penandatangan JWT (buat acak: openssl rand -hex 32)
JWT_SECRET="ganti-dengan-string-acak-64-karakter"

# ============ Superadmin default (dipakai saat seed pertama) ============
SUPERADMIN_USERNAME="Jeffsca"
SUPERADMIN_PASSWORD="ganti-di-produksi"

# Password akses sementara untuk Admin/PIC membuka section terkunci
TEMP_ACCESS_PASSWORD="ganti-di-produksi"
OWNER_EMAIL=""

# ============ Cloudflare R2 (foto bukti tahap PO Tracker) ============
# Lihat README bagian "Cloudflare R2". Dapatkan dari Cloudflare Dashboard > R2 > Manage R2 API Tokens.
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key"
R2_SECRET_ACCESS_KEY="your-secret"
R2_BUCKET_NAME="scaportalstroage"
# Public URL bucket: aktifkan "R2.dev subdomain" di Settings bucket, atau pakai custom domain
R2_PUBLIC_URL="https://cdn.scaportal.cloud"

# ============ Runtime (sudah diset di Dockerfile, tidak perlu diisi di Coolify) ============
# PORT=3000
# HOSTNAME=0.0.0.0
# NODE_ENV=production

# Kosongkan bila API berada pada origin yang sama (default)
# NEXT_PUBLIC_API_BASE="/api"
